APP_NAME="Faster Delivery Buddy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_DISPLAY_TIMEZONE=Asia/Manila

# Comma-separated document types every seller application must include (placeholder policy)
FDB_SELLER_REQUIRED_DOCUMENTS=government_id
FDB_SELLER_DOCUMENTS_DISK=seller_documents
# Placeholder policy: listings need FDB approval before customers see them
FDB_LISTING_REQUIRES_REVIEW=true
FDB_MEDIA_DISK=media
# Payment methods customers can select. GCash, Maya, and Other show as "Coming soon" until listed here.
FDB_PAYMENT_METHODS=cash_on_delivery
# Placeholder: first default commission rate (fraction). Admins manage rates in the app afterwards.
FDB_INITIAL_COMMISSION_RATE=0.0750
# Test sites without working email can set this to false (seller applications still need admin approval).
FDB_REQUIRE_EMAIL_VERIFICATION=true
FDB_DISPUTE_WINDOW_DAYS=7
FDB_REFUND_COMMISSION=proportional
MEDIA_URL=/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fdb
DB_USERNAME=fdb
DB_PASSWORD=fdb_local_only
# Optional: a hosted database such as Neon. DB_URL wins over the DB_* values above.
# DB_URL=
# DB_SSLMODE=require
# DB_PERSISTENT=true

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=fdb

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@fdb.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
