# Copy to backend/.env.production on the server and replace every CHANGE_ME. Never commit the copy.
APP_NAME="Faster Delivery Buddy"
APP_ENV=production
# Generate with: docker compose -f docker-compose.prod.yml run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=CHANGE_ME
APP_DEBUG=false
# The SPA and the API share one public origin in production.
APP_URL=https://CHANGE_ME.example
FRONTEND_URL=https://CHANGE_ME.example
APP_DISPLAY_TIMEZONE=Asia/Manila

# Placeholder policies: confirm each with the founders before launch (docs/RELEASE.md).
FDB_SELLER_REQUIRED_DOCUMENTS=government_id
FDB_SELLER_DOCUMENTS_DISK=seller_documents
FDB_LISTING_REQUIRES_REVIEW=true
FDB_MEDIA_DISK=media
FDB_PAYMENT_METHODS=cash_on_delivery
FDB_INITIAL_COMMISSION_RATE=0.0750
FDB_REQUIRE_EMAIL_VERIFICATION=true
FDB_DISPUTE_WINDOW_DAYS=7
FDB_REFUND_COMMISSION=proportional
MEDIA_URL=/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Containers log to stderr so `docker compose logs` and the host collect them.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# IP or range of the load balancer that terminates TLS in front of the web container.
TRUSTED_PROXIES=CHANGE_ME

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fdb
DB_USERNAME=fdb
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Host of the public site, without https://
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME.example

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=fdb

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# Email is not connected yet: messages are written to the log until a provider is chosen.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME.example"
MAIL_FROM_NAME="${APP_NAME}"
